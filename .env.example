RESEND_API_KEY=
ESTIMATE_FROM_EMAIL=quotes@your-domain.com
ESTIMATE_TO_EMAIL=info@steamzone.ca

# Supabase (server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin pricing save endpoint
ADMIN_PRICING_TOKEN=

# GoHighLevel (recommended: direct API sync from /api/estimate-create)
# Create a Private Integration Token in GHL and set these in Vercel.
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
# Safety check (optional but recommended)
GHL_EXPECT_LOCATION_NAME=
# Optional opportunity routing
GHL_PIPELINE_NAME=Steam Zone – Jobs
GHL_STAGE_NAME_DEFAULT=New Lead
# Advanced overrides
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# GoHighLevel inbound webhook (legacy optional)
GHL_INBOUND_WEBHOOK_URL=
GHL_WEBHOOK_SECRET=

# Frontend estimate embeds (Vite public env vars)
# Legacy single-form fallback (used for all services if per-service URLs are not set)
VITE_GHL_ESTIMATE_FORM_EMBED_URL=
# Recommended per-service embeds
VITE_GHL_ESTIMATE_FORM_EMBED_URL_WINDOW=
VITE_GHL_ESTIMATE_FORM_EMBED_URL_COMMERCIAL_WINDOW=
VITE_GHL_ESTIMATE_FORM_EMBED_URL_CARPET=
VITE_GHL_ESTIMATE_FORM_EMBED_URL_POST_CONSTRUCTION=
VITE_GHL_VOICE_CONVERSATION_EMBED_URL=
# Optional fallback when embedding via chat-widget script on /call-us
# Public location id used for voice-only embed mode fallback.
VITE_GHL_LOCATION_ID=
VITE_GHL_VOICE_WIDGET_ID=
VITE_GHL_VOICE_AGENT_ID=
VITE_GHL_VOICE_AGENT_NAME=
VITE_GHL_VOICE_AGENT_DESCRIPTION=
